{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "athymetoheal",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "c26f37bc90e74b1b97b4a2bcf6a940e3"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["17 9 * * *", "10 16 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
